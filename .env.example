# Copy to .env locally. Never commit real secrets.
APP_ENV=development
DATABASE_PATH=./data/guardian.db
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
SESSION_TTL_MINUTES=30
# Live broker execution is intentionally not enabled in this build.

# Telegram is outbound-only reporting. It does not approve access or accept commands.
# Keep real values in local environment / GitHub Actions Secrets, never commit them.
TELEGRAM_REPORTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
